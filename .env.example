# AdGuard VPN CLI — Environment Configuration
#
# Copy this file to .env and adjust values for your setup.
#
#   cp .env.example .env
#
# NOTE: Authentication is now web-based (OAuth device code flow).
# Run the container and follow the URL printed in the logs to
# authenticate in your browser.
#
# VPN server location code (e.g. JP, US, SG, NL)
# Type: string  Default: JP
ADGUARD_CONNECTION_LOCATION=JP

# Connection mode: TUN (kernel-level tunnel) or SOCKS (SOCKS5 proxy)
# Type: enum  Default: TUN
ADGUARD_CONNECTION_TYPE=TUN

# SOCKS5 proxy username
# Type: string  Default: username
ADGUARD_SOCKS5_USERNAME=username

# SOCKS5 proxy password
# Type: string  Default: password
ADGUARD_SOCKS5_PASSWORD=password

# SOCKS5 proxy host address
# Type: ip  Default: 127.0.0.1
ADGUARD_SOCKS5_HOST=127.0.0.1

# SOCKS5 proxy port
# Type: port  Default: 1080
ADGUARD_SOCKS5_PORT=1080

# Enable kill switch to prevent IP leaks when VPN drops
# Type: bool  Default: true
ADGUARD_USE_KILL_SWITCH=true

# Kill switch check interval in seconds
# Type: positive_int  Default: 15
ADGUARD_USE_KILL_SWITCH_CHECK_INTERVAL=15

# Number of leak detections before termination (0 = immediate termination on first leak)
# Type: non_negative_int  Default: 0
ADGUARD_MAX_LEAK_TOLERANCE=0

# Only warn on leaks, do not terminate
# Type: bool  Default: false
ADGUARD_LEAK_WARNING_ONLY=false

# Maximum IP detection retry attempts
# Type: positive_int  Default: 3
ADGUARD_MAX_IP_DETECTION_RETRIES=3

# Delay in seconds between IP detection retries
# Type: positive_int  Default: 10
ADGUARD_IP_DETECTION_RETRY_DELAY=10

# Use a custom DNS server instead of the system default
# Type: bool  Default: true
ADGUARD_USE_CUSTOM_DNS=true

# Custom DNS server address
# Type: dns  Default: 1.1.1.1
ADGUARD_CUSTOM_DNS=1.1.1.1

# Allow AdGuard VPN to change the system DNS configuration
# Type: bool  Default: false
ADGUARD_SET_SYSTEM_DNS=false

# Send crash reports to AdGuard
# Type: bool  Default: false
ADGUARD_SEND_REPORTS=false

# Send anonymous telemetry data
# Type: bool  Default: false
ADGUARD_TELEMETRY=false

# Automatically update AdGuard VPN CLI on startup
# Type: bool  Default: false
ADGUARD_AUTO_UPDATE=false

# Update channel: release, beta, or dev
# Type: enum  Default: release
ADGUARD_UPDATE_CHANNEL=release

# Show CLI usage hints (on/off)
# Type: enum  Default: on
ADGUARD_SHOW_HINTS=on

# Enable debug logging in AdGuard CLI (on/off)
# Type: enum  Default: on
ADGUARD_DEBUG_LOGGING=on

# Show desktop notifications (on/off)
# Type: enum  Default: on
ADGUARD_SHOW_NOTIFICATIONS=on

# VPN protocol (auto, TCP, QUIC)
# Type: enum  Default: auto
ADGUARD_PROTOCOL=auto

# Post-quantum encryption (on/off)
# Type: enum  Default: off
ADGUARD_POST_QUANTUM=off

# TUN routing mode (AUTO, TUN_ONLY, PROXY_ONLY)
# Type: enum  Default: AUTO
ADGUARD_TUN_ROUTING_MODE=AUTO

# Override bound network interface for VPN (empty = auto)
# Type: string  Default: 
ADGUARD_BOUND_IF_OVERRIDE=

# User ID for the container's app user (default avoids conflict with Ubuntu built-in ubuntu user at 1000)
# Type: positive_int  Default: 1001
PUID=1001

# Group ID for the container's app user (default avoids conflict with Ubuntu built-in ubuntu group at 1000)
# Type: positive_int  Default: 1001
PGID=1001

# Container log level: DEBUG, INFO, WARN, ERROR
# Type: enum  Default: INFO
ADGUARD_LOG_LEVEL=INFO

